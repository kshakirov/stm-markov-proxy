module Main where

import Control.Concurrent (forkIO)
import Control.Concurrent.Async (link, withAsync)
import Control.Monad (void)
import Control.Exception (bracket)
import Network.Socket (Socket)
import Proxy.Transport.TcpInput
  ( TcpState(..), openResourceOnly, acceptForeachAndIter
  , tcpRead, tcpWrite, closeAccetpResource
  )
import Proxy.Transport.UnixSocketOutput
  ( connectUnixSocket, unixSocekWrite, unixSocketRead, closeUnixSocket )

compose f g state = do
  result <- f state
  case result of
    Left done -> pure (Left done)
    Right next -> g next

iter :: (s -> IO (Either r s)) -> s -> IO r
iter step state = do
  result <- step state
  case result of
    Left done -> pure done
    Right next -> iter step next

forkWrapper state acquireTcp prepare step1 step2 closeTcp closeUnix = do
  _ <- forkIO $
    bracket (acquireTcp state) closeTcp $ \_ ->
      bracket (prepare state) closeUnix (useResource step1 step2)
  pure (Right state)

tcpSockFromState :: TcpState -> IO Socket
tcpSockFromState state = pure (socket state)

useResource step1 step2 state =
  withAsync (void (iter step1 state)) $ \task -> do
    link task
    void (iter step2 state)

prepare :: TcpState -> IO TcpState
prepare state = do
  output <- connectUnixSocket <%= socket_path_literal %>
  pure (state {unixSocket = output})

main :: IO ()
main = do
  listenerState <- openResourceOnly <%= host_literal %> <%= port %>
  void $ iter
    (compose acceptForeachAndIter
      (\state -> forkWrapper state tcpSockFromState prepare
        (compose tcpRead unixSocekWrite)
        (compose unixSocketRead tcpWrite)
        closeAccetpResource closeUnixSocket))
    listenerState
