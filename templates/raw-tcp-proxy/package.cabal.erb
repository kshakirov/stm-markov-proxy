cabal-version: 3.0
name: <%= package_name %>
version: 0.1.0.0
build-type: Simple

executable <%= name %>
    main-is: Main.hs
    hs-source-dirs: app
    default-language: Haskell2010
    ghc-options: -Wall
    build-depends:
<% dependencies.each_with_index do |dependency, index| -%>
        <%= dependency %><%= "," unless index == dependencies.length - 1 %>
<% end -%>
